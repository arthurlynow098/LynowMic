<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B10"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="18dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="54dp"
                android:layout_height="54dp"
                android:contentDescription="Logo Lynow Mic"
                android:scaleType="centerCrop"
                android:src="@drawable/lynow_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    style="@style/Copy"
                    android:text="LYNOW MIC"
                    android:textColor="#FFFFFF"
                    android:textSize="24sp"
                    android:fontFamily="sans-serif-black" />

                <TextView
                    style="@style/Copy"
                    android:text="TRANSMISSOR MÓVEL · ANDROID"
                    android:textColor="#9D7AFF"
                    android:textSize="10sp"
                    android:letterSpacing="0.08"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/Copy"
            android:layout_marginTop="22dp"
            android:text="Sua voz, sem fios."
            android:textColor="#FFFFFF"
            android:textSize="28sp"
            android:fontFamily="sans-serif-medium" />

        <TextView
            style="@style/Copy"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Conecte ao Lynow Mic para Windows e transforme este celular em um microfone de baixa latência."
            android:textColor="#9591A7" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/badge"
                style="@style/Copy"
                android:text="○  PRONTO PARA CONECTAR"
                android:textSize="11sp"
                android:textColor="#9D7AFF"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/connectionTitle"
                style="@style/Copy"
                android:layout_marginTop="12dp"
                android:text="Encontre seu computador"
                android:textColor="#FFFFFF"
                android:textSize="21sp"
                android:fontFamily="sans-serif-bold" />

            <TextView
                android:id="@+id/status"
                style="@style/Copy"
                android:layout_marginTop="6dp"
                android:text="Abra o Lynow Mic no Windows e toque em Preparar conexão."
                android:textColor="#9591A7" />

            <com.lynow.mic.LevelView
                android:id="@+id/meter"
                android:layout_width="match_parent"
                android:layout_height="112dp"
                android:layout_marginTop="16dp"
                android:contentDescription="Nível do áudio transmitido" />

            <TextView
                android:id="@+id/time"
                style="@style/Copy"
                android:layout_marginBottom="18dp"
                android:fontFamily="monospace"
                android:gravity="center"
                android:text="00:00:00"
                android:textColor="#9D7AFF"
                android:textSize="14sp" />

            <Button
                android:id="@+id/connect"
                style="@style/PrimaryButton"
                android:text="Escanear QR Code" />

            <Button
                android:id="@+id/manual"
                style="@style/SecondaryButton"
                android:layout_marginTop="10dp"
                android:text="Colar código de conexão" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                style="@style/Copy"
                android:text="CONTROLE DO MICROFONE"
                android:textSize="11sp"
                android:textColor="#9D7AFF"
                android:letterSpacing="0.08"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/gainLabel"
                style="@style/Copy"
                android:layout_marginTop="16dp"
                android:text="Ganho de entrada · 100%"
                android:textColor="#FFFFFF"
                android:fontFamily="sans-serif-medium" />

            <SeekBar
                android:id="@+id/gain"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:max="200"
                android:progress="100"
                android:progressTint="#7B4DFF"
                android:thumbTint="#FFFFFF"
                android:contentDescription="Ganho de entrada" />

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/noise"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="Redução de ruído do Android"
                android:textColor="#E0DCF2" />

            <TextView
                style="@style/Copy"
                android:text="Disponível conforme o hardware do aparelho. Ajuste antes de conectar."
                android:textColor="#787291"
                android:textSize="12sp" />

            <Button
                android:id="@+id/mute"
                style="@style/SecondaryButton"
                android:layout_marginTop="16dp"
                android:enabled="false"
                android:text="Silenciar microfone" />
        </LinearLayout>

        <TextView
            style="@style/Copy"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:letterSpacing="0.08"
            android:text="MESMA REDE · CONEXÃO DIRETA P2P"
            android:textColor="#6C6785"
            android:textSize="10sp" />

        <TextView
            style="@style/Copy"
            android:layout_marginTop="7dp"
            android:gravity="center"
            android:text="Sem conta, anúncios ou limite de sessão.\n48 kHz · mono · conexão criptografada TLS"
            android:textColor="#6C6785"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
