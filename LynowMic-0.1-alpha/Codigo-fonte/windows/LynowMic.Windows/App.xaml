<Application x:Class="LynowMic.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <!-- Royal Purple & Violet Brand Palette (Hummingbird Identity) -->
  <SolidColorBrush x:Key="BrandPurple" Color="#7B4DFF"/>
  <SolidColorBrush x:Key="BrandPurpleLight" Color="#9D7AFF"/>
  <SolidColorBrush x:Key="BrandPurpleGlow" Color="#5B2DEE"/>
  <SolidColorBrush x:Key="BrandSurface" Color="#13121D"/>
  <SolidColorBrush x:Key="BrandBorder" Color="#26233A"/>
  <SolidColorBrush x:Key="TextPrimary" Color="#F4F3F7"/>
  <SolidColorBrush x:Key="TextMuted" Color="#9591A7"/>

  <Style TargetType="TextBlock">
   <Setter Property="Foreground" Value="#F4F3F7"/>
   <Setter Property="FontFamily" Value="Segoe UI, Inter, Arial"/>
  </Style>

  <Style TargetType="Button">
   <Setter Property="Background" Value="#221F36"/>
   <Setter Property="Foreground" Value="#F4F3F7"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="12,0"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True">
        <Setter TargetName="Surface" Property="Opacity" Value="0.88"/>
       </Trigger>
       <Trigger Property="IsEnabled" Value="False">
        <Setter TargetName="Surface" Property="Opacity" Value="0.35"/>
       </Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <Style TargetType="ComboBox">
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Padding" Value="10,6"/>
   <Setter Property="MinHeight" Value="38"/>
   <Setter Property="Foreground" Value="#F4F3F7"/>
   <Setter Property="Background" Value="#1A172E"/>
   <Setter Property="BorderBrush" Value="#2F2952"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>

  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="#13121D"/>
   <Setter Property="CornerRadius" Value="18"/>
   <Setter Property="BorderBrush" Value="#26233A"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="24"/>
  </Style>
 </Application.Resources>
</Application>
