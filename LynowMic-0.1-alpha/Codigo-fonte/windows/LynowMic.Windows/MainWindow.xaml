                        <Button Click="CloseHelpModal_Click" Content="Entendido" Height="38" Background="#5B2DEE" Foreground="#FFFFFF" FontWeight="Bold" FontSize="13" Padding="0">
                            <Button.Resources>
                                <Style TargetType="Border"><Setter Property="CornerRadius" Value="8"/></Style>
