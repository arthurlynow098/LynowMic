                        </Border>
                        <!-- Step 4 -->
                        <Border Background="#17142B" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                            <TextBlock Text="4. Abra o Lynow Mic no celular e escaneie o código na tela." FontSize="12" Foreground="#DDD9F5"/>
                        </Border>
                        <!-- Step 5 -->
                        <Border Background="#17142B" CornerRadius="8" Padding="12,10" Margin="0,0,0,16">
